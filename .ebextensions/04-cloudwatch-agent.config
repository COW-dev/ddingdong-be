# 자체호스팅 모니터링(Alloy/Promtail/Loki/Prometheus)을 폐지하고 CloudWatch로 이전.
# CloudWatch Agent가 앱 로그(logs/application.log)를 CW Logs로 전송하고,
# 서버 스펙(CPU/메모리/디스크/프로세스)을 CWAgent 네임스페이스로 수집한다.
# JVM 커스텀 메트릭은 push 하지 않는다(비용 0, 필요 시 Actuator 직접 조회).
#
# 사전 조건: EB 인스턴스 프로파일(aws-elasticbeanstalk-ec2-role 등)에
#            CloudWatchAgentServerPolicy 관리형 정책이 부착되어 있어야 한다.
files:
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "agent": {
          "metrics_collection_interval": 60,
          "run_as_user": "root"
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/app/current/logs/application.log",
                  "log_group_name": "/ddingdong/prod/application",
                  "log_stream_name": "{instance_id}",
                  "timezone": "Local",
                  "retention_in_days": 30
                }
              ]
            }
          }
        },
        "metrics": {
          "namespace": "CWAgent",
          "append_dimensions": {
            "InstanceId": "${aws:InstanceId}"
          },
          "aggregation_dimensions": [["InstanceId"]],
          "metrics_collected": {
            "cpu": {
              "measurement": ["cpu_usage_idle", "cpu_usage_user", "cpu_usage_system"],
              "totalcpu": true
            },
            "mem": {
              "measurement": ["mem_used_percent", "mem_available", "mem_used"]
            },
            "disk": {
              "measurement": ["used_percent", "used", "total"],
              "resources": ["/"]
            },
            "swap": {
              "measurement": ["swap_used_percent"]
            },
            "processes": {
              "measurement": ["running", "sleeping", "total"]
            }
          }
        }
      }

container_commands:
  # 설치/기동을 non-fatal로: 모니터링 에이전트 문제가 앱 배포를 절대 깨지 않도록 한다.
  # Amazon Linux 2(yum)·AL2023(dnf)·직접 RPM 순으로 시도, 모두 실패해도 배포는 계속.
  01_install_cw_agent:
    command: |
      if ! rpm -q amazon-cloudwatch-agent >/dev/null 2>&1; then
        (yum install -y amazon-cloudwatch-agent 2>/dev/null) \
          || (dnf install -y amazon-cloudwatch-agent 2>/dev/null) \
          || (curl -fsSL "https://s3.amazonaws.com/amazoncloudwatch-agent/amazon_linux/amd64/latest/amazon-cloudwatch-agent.rpm" -o /tmp/cwagent.rpm && rpm -U /tmp/cwagent.rpm) \
          || echo "WARN: CloudWatch Agent 설치 실패 - 앱 배포는 계속 진행"
      fi
    ignoreErrors: true
  02_start_cw_agent:
    command: |
      if [ -x /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl ]; then
        /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
          -a fetch-config -m ec2 -s \
          -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
          || echo "WARN: CloudWatch Agent 기동 실패 - 앱 배포는 계속 진행"
      fi
    ignoreErrors: true
