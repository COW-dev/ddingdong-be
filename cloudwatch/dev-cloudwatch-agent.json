{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/logs/application.log",
            "log_group_name": "/ddingdong/dev/application",
            "log_stream_name": "{hostname}",
            "timezone": "Local",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
